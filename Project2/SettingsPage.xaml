<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Project2.SettingsPage"
             Title="Settings">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Settings" FontSize="24" HorizontalOptions="Center"/>

        <HorizontalStackLayout Spacing="10">
            <Label Text="Dark Mode" VerticalOptions="Center"/>
            <Switch Toggled="OnDarkModeToggled"/>
        </HorizontalStackLayout>

        <Button Text="Logout" Clicked="OnLogoutClicked"/>
    </VerticalStackLayout>
</ContentPage>
