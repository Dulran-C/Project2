<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Project2.MainPage"
             Title="Movies">

    <Grid RowSpacing="10" Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <SearchBar x:Name="SearchBarControl"
                       Placeholder="Search movies..."
                       TextChanged="SearchBar_TextChanged"/>

            <HorizontalStackLayout VerticalOptions="Center" Spacing="10">
                <Switch x:Name="ShowFavouritesSwitch"
                        Toggled="ShowFavouritesSwitch_Toggled"/>
                <Label Text="Show only favourites"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <CollectionView x:Name="MoviesView"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="MoviesView_SelectionChanged">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout Padding="8" Spacing="12" VerticalOptions="Center">
                        <Label Text="{Binding Emoji}" FontSize="28"/>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Title}" FontSize="16"/>
                            <Label Text="{Binding Director}" FontSize="12" TextColor="Gray"/>
                            <Label Text="{Binding Genre}" FontSize="12" TextColor="DarkGray"/>
                            <Label Text="{Binding Rating, StringFormat='Rating: {0:F1}'}" FontSize="12" TextColor="DarkGray"/>
                        </VerticalStackLayout>
                        <Button Text="♡"
                                Clicked="OnFavouriteClicked"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                FontSize="20"
                                BindingContext="{Binding}"/>
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
