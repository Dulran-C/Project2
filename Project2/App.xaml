<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Project2.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- BACKGROUNDS -->
            <Color x:Key="AppBackgroundLight">#F5F7FA</Color>
            <Color x:Key="AppBackgroundDark">#0B0B0B</Color>

            <!-- TEXT -->
            <Color x:Key="PrimaryTextLight">#1E1E1E</Color>
            <Color x:Key="PrimaryTextDark">#FFFFFF</Color>

            <!-- ACCENT -->
            <Color x:Key="AccentLight">#5E35B1</Color>
            <Color x:Key="AccentDark">#E50914</Color>

            <!-- CARD -->
            <Color x:Key="CardLight">#FFFFFF</Color>
            <Color x:Key="CardDark">#1A1A1A</Color>

        </ResourceDictionary>
    </Application.Resources>
</Application>
