<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Project2"
             x:Class="Project2.MainPage"
             Title="Movies">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:GenreToEmojiConverter x:Key="GenreToEmojiConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowSpacing="10" Padding="10" BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <SearchBar x:Name="SearchBarControl"
                       Placeholder="Search movies..."
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                       BackgroundColor="Transparent"
                       TextChanged="SearchBar_TextChanged"/>

            <Button Text="Filters"
                    Clicked="OnOpenFilterClicked"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="40"/>

            <HorizontalStackLayout VerticalOptions="Center" Spacing="10">
                <Switch x:Name="ShowFavouritesSwitch"
                        Toggled="ShowFavouritesSwitch_Toggled"
                        OnColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                <Label Text="Show only favourites"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <CollectionView x:Name="MoviesView"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="MoviesView_SelectionChanged">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="8"
                           CornerRadius="10"
                           BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">

                            <Label Text="{Binding Emoji}" FontSize="28"/>

                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Title}" FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"/>
                                <Label Text="{Binding Director}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"/>
                                <Label Text="{Binding Genre, Converter={StaticResource GenreToEmojiConverter}}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"/>
                                <Label Text="{Binding Rating, StringFormat='Rating: {0:F1}'}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"/>
                            </VerticalStackLayout>

                            <Button Text="♡"
                                    Clicked="OnFavouriteClicked"
                                    FontSize="20"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    BindingContext="{Binding}"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>


                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
