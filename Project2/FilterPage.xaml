<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Project2.FilterPage"
             Title="Filter Movies"
             Padding="20">

    <VerticalStackLayout Spacing="20">

        <!-- Genre Picker -->
        <Label Text="Genre:" FontAttributes="Bold"/>
        <Picker x:Name="GenrePicker">
            <Picker.Items>
                <x:String>All</x:String>
                <x:String>Action</x:String>
                <x:String>Comedy</x:String>
                <x:String>Drama</x:String>
                <x:String>Horror</x:String>
            </Picker.Items>
        </Picker>

        <!-- Director Entry -->
        <Label Text="Director:" FontAttributes="Bold"/>
        <Entry x:Name="DirectorEntry" Placeholder="Enter director name"/>

        <!-- Rating Slider -->
        <Label Text="Minimum Rating:" FontAttributes="Bold"/>
        <Slider x:Name="RatingSlider" Minimum="0" Maximum="10" Value="0"/>
        <Label x:Name="RatingValueLabel" Text="Rating: 0.0" FontAttributes="Italic" TextColor="Gray"/>

        <!-- Apply Button -->
        <Button Text="Apply Filter" Clicked="OnApplyFilterClicked"/>

    </VerticalStackLayout>
</ContentPage>
